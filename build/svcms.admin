#!/bin/bash
npm run build
basedir="/mnt/stg_w01/var/www/svcms/admin/frontend/"
#echo "$basedir/css"
check=${#basedir}
if [ $check -ge 10 ]
then
    echo "basedir ok"
    rm -rf "$basedir/css"
    rm -rf "$basedir/js"
    #rm  "$basedir/index.html"
    rm -rf "$basedir/fonts"
    rm -rf "$basedir/page_constructor"    
    cp -R dist/{js,css,index.html,fonts,page_constructor} "$basedir/"
else
    echo "error basedir"
fi

