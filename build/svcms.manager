#!/usr/bin/env bash
set -euo pipefail

# Деплой svcms-manager (CRM) фронта на прод (stg-web01) по rsync.
#
# Было: сборка + `cp -R dist/{js,css,index.html,fonts}` в смонтированную папку
# (и configure.js не заливался вовсе -> «дрейф» настроек).
# Стало: rsync всего dist/ по ssh + env-специфичный configure.js для svcmsmanager.
#
# ENV: SSH_PORT=7725 SSH_USER=naumov SSH_HOST=185.76.252.12
#      REMOTE_DIR=/var/www/svcms/manager/frontend   (рантайм менеджера, nginx)
#
# Favicon: каноническая иконка лежит в build/favicon/ (DigitalStrateg, как на
# demo1.digitalstrateg.ru). В dist/ попадает public/favicon.ico, поэтому он
# исключён из rsync -- загруженный на прод favicon билдом не перезатирается.

SSH_PORT="${SSH_PORT:-7725}"
SSH_USER="${SSH_USER:-naumov}"
SSH_HOST="${SSH_HOST:-185.76.252.12}"
REMOTE_DIR="${REMOTE_DIR:-/var/www/svcms/manager/frontend}"

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"   # .../build
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"                          # CrmFreshFront
cd "$ROOT"

echo "▶ сборка: npm run build_svcms (vite build --mode svcms)"
npm run build_svcms

# env-специфичный configure.js именно для svcmsmanager (в public/ он dev-овый)
CONF="$SCRIPT_DIR/config/svcmsmanager/configure.js"
if [ ! -f "$CONF" ]; then
    echo "❌ не найден $CONF"
    exit 1
fi
cp "$CONF" dist/configure.js

DST="$SSH_USER@$SSH_HOST:$REMOTE_DIR/"
RSYNC=(rsync -rltvz --no-perms --no-owner --no-group --human-readable
       -e "ssh -p $SSH_PORT")

# Заливаем ВЕСЬ dist/ (js/css/fonts/index.html/dist-ассеты/configure.js),
# не удаляя серверные файлы. `files` не трогаем: на сервере это симлинк
# на ../backend/files. `/favicon*` (только корень) не трогаем: favicon на проде
# живёт отдельно от билда (build/favicon), деплой его НЕ перезаписывает.
# Вложенные favicon* (page_constructor/template/images/favicon.svg) обновляем.
echo "▶ rsync dist/ -> $DST (без --delete, исключая files, /favicon*)"
"${RSYNC[@]}" --exclude='files' --exclude='/favicon*' dist/ "$DST"

# Favicon: кладём только если на сервере его ещё нет (--ignore-existing).
# Загруженный вручную favicon на проде не перезатирается никогда.
if [ -d "$SCRIPT_DIR/favicon" ]; then
    echo "▶ favicon -> $DST (--ignore-existing: не перезаписывать существующий)"
    "${RSYNC[@]}" --ignore-existing "$SCRIPT_DIR/favicon/" "$DST"
fi

echo "✅ Деплой svcms-manager: $REMOTE_DIR"
